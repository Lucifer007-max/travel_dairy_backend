# Copy to .env and fill in. Never commit .env, and never put real values here:
# this file is committed and public.

PORT=8787
LOG_LEVEL=info

# --- Database (Supabase Postgres) -------------------------------------------
# Supabase dashboard → Connect → "Session pooler" URI (works over IPv4), e.g.
# postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (The "Direct connection" host db.<project-ref>.supabase.co is IPv6-only.)
DATABASE_URL=postgres://localhost:5432/traveldiary_dev
# true for Supabase, false for a local Postgres
DATABASE_SSL=false

# --- Sessions -----------------------------------------------------------------
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL=30d

# --- Google sign-in -----------------------------------------------------------
# The *Web application* OAuth client ID (the same one the app uses as serverClientId).
# Not the Android client ID. Comma-separate several if needed. No client secret is needed.
GOOGLE_CLIENT_IDS=

# --- Photo storage ------------------------------------------------------------
# "supabase" in production, "local" (files on this machine) for development.
STORAGE_DRIVER=local
# Supabase dashboard → Project Settings → API Keys. Use the SECRET key
# (sb_secret_… or legacy service_role), not the publishable key. It stays on
# this server and must never be put in the app or committed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=photos
LOCAL_STORAGE_DIR=./uploads
# How the app reaches this server (used for local photo links).
# Android emulator → http://10.0.2.2:8787 ; a real phone → http://<this computer's LAN IP>:8787
PUBLIC_BASE_URL=http://10.0.2.2:8787
SIGNED_URL_TTL_SECONDS=86400
MAX_UPLOAD_MB=15

# Only needed for browser clients; comma-separated origins.
CORS_ORIGINS=
